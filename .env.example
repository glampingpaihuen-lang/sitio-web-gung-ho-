# Copia este archivo como .env.local y llena los valores (los mismos de nube-admin).
# Si los dejas vacíos, en el PC lee las pruebas de la carpeta ../.datos que llena el panel.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Dirección pública del bucket de Cloudflare R2 donde están las fotos y videos (https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
